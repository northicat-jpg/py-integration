# 复制为 config.config 后按现场修改。
# INI 风格： [section] + key = value
# 支持 ${ENV_VAR} 与 ${ENV_VAR:默认值}。

[rcs]
# 直连后端: http://host:8888
# 走网关/网页同入口: http://host:9080/prod-api  （不要填浏览器页面路径如 /index.html）
base_url = ${RCS_BASE_URL:http://191.13.16.107:9080/prod-api}
username = ${RCS_USERNAME:system}
# 含 # 的密码请加引号，避免被当成 INI 注释
password = ${RCS_PASSWORD:"!@#zxasqw2022"}
timeout_sec = 30
login_path = /login
token_json_path = token
robot_list_path = /system/robot/list
robot_dept_path = /system/robot/dept/{dept_id}
robot_state_dict_path = /system/dict/data/type/sys_robot_state
dept_id = 100

[tcp]
host = ${TCP_LISTEN_HOST:0.0.0.0}
port = 9100
framing = line
delimiter = \n
fixed_length = 0
encoding = utf-8
welcome =

[parser]
# 第一次（必带三要素）：{"robot":"01","start_point_id":100,"end_point_id":200}
# 第二次：格式待定，不需要 DONE/cmd；等到点通知后，任意一行都会触发离开任务
#   例如 {} / OK / 空行 / 其它明文均可（allow_empty=true）
type = json
allow_empty = true
cast.start_point_id = int
cast.end_point_id = int
cast.point_id = int
cast.map_id = int
cast.template_id = int

# ---------- 小车绑定：短码 → 编号(robotId) / 名称 / 停靠点(home) / 地图 ----------
# 写法：短码 = robotId | 名称 | home_point_id | map_id
# CALL 段：home_point_id → start_point_id（TCP 起点=站台）
# DONE 段：start_point_id → end_point_id（TCP 终点）
# !!! home_point_id / map_id 请按现场地图点位改成真实 ID !!!
[robots]
01 = 11 | AGV01 | 1 | 31


# ---------- CALL 路由：robot:start_point_id = template_id | task_name ----------
# 第一段任务（停车点 → 站台起点）选用哪套 RCS 任务模板
[call_routes]
01:4 = 35665 | DHZTTCP1


# ---------- DONE 路由：robot:start:end = template_id | task_name ----------
# 第二段任务（站台起点 → 货物终点）；也可用 start:end（不写 robot）
[leave_routes]
01:4:1 = 35666 | DHZTTCP2


# ---------- 去点任务（CALL，填包前已由路由解析出 template_id/task_name/robot_id）----------
[task]
mode = template
payload_template_file = payload_arrive.json
task_id_json_path = data.taskId

# ---------- 离开任务（DONE）----------
[task_leave]
mode = template
payload_template_file = payload_leave.json
task_id_json_path = data.taskId

# ---------- 握手流程 ----------
[workflow]
enabled = true
# 第一次靠三要素识别；第二次不依赖 cmd/DONE（格式 TBD，任意报文=离开）
signal_field = cmd
signal_call = CALL
signal_done = DONE
# 空=同一 TCP 连接完成握手；跨连接可填 device_id 等
session_key_field =
# 一般不要写死；由 TCP robot 短码 + [robots] 解析
robot_id =
robot_code_field = robot
robot_id_field = robot_id
# TCP 三要素字段名
start_point_field = start_point_id
end_point_field = end_point_id
# 兼容旧字段：到点轮询默认用解析后的 point_id（CALL=站台起点）
point_id =
point_id_field = point_id

[poll]
interval_sec = 1.0
timeout_sec = 300
robot_status_path = /system/robot/status/{robot_id}
task_info_path = /system/task/{task_id}
# 现场实包：点位在 lastPoint/currentPosition，运行态在 robotStatusVo.state（数字，非 IDLE 字符串）
status_state_path = data.robotStatusVo.state
status_point_path = data.lastPoint.originalId
task_status_path = data.status
accept_states = 1
require_task_finished = false
wait_idle_after_leave = true
idle_states = 1

[notify]
mode = same_connection
host =
port = 0
message = ARRIVE_OK\n
encoding = utf-8

[runtime]
dry_run = false
log_raw_message = true
